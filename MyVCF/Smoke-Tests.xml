<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Smoke Tests Suite" verbose="1" parallel="false">

  <!-- Default parameters for smoke runs -->
  <parameter name="browser" value="edge"/>
  <parameter name="headless" value="false"/>
  <parameter name="baseUrl" value="https://vcf--sit.sandbox.my.site.com/myvcf/s/login/"/>
  <parameter name="waitSeconds" value="5"/>

  <test name="Smoke Sanity">
    <classes>
      <!-- Add your quick health-check classes here -->
      <class name="com.myvcf.tests.PortalTitleTest"/>
      <!-- Example: <class name="com.myvcf.tests.smoke.LoginTest"/> -->
    </classes>
  </test>

</suite>